{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      
      "react-native": ["./stubs/react-native.ts"],
      "expo-constants": ["./stubs/expo-constants.ts"],
      "expo-notifications": ["./stubs/expo-notifications.ts"],
      "expo-document-picker": ["./stubs/expo-document-picker.ts"],
      "expo-file-system/legacy": ["./stubs/expo-file-system-legacy.ts"],
      "expo-sharing": ["./stubs/expo-sharing.ts"]
    }
  },
  "include": ["**/*.ts", "../src/**/*.ts"]
}
