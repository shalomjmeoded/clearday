{
  "name": "clearday",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:backup": "node --import tsx --import ./test-harness/loader.mjs --require ./test-harness/register-cjs.cjs test-harness/run-tests.ts",
    "test:unit": "node --import tsx --import ./test-harness/loader.mjs --require ./test-harness/register-cjs.cjs test-harness/run-unit-tests.ts",
    "test": "npm run test:unit && npm run test:backup",
    "check:release": "npx expo install --check && npx tsc --noEmit && npx expo config --type public",
    "build:ios:production": "npx eas-cli build --platform ios --profile production",
    "build:ios:production:submit": "npx eas-cli build --platform ios --profile production --auto-submit",
    "submit:ios:production": "npx eas-cli submit --platform ios --profile production --latest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/native": "^7.1.8",
    "babel-preset-expo": "~54.0.10",
    "date-fns": "^4.2.1",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-purchases": "^10.1.2",
    "react-native-purchases-ui": "^10.1.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "react-test-renderer": "19.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  },
  "private": true
}
