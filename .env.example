# RevenueCat — use your project keys from https://app.revenuecat.com
# Test Store key (sandbox) works on iOS and Android during development:
EXPO_PUBLIC_REVENUECAT_API_KEY=your_revenuecat_public_api_key

# Production: use platform-specific public SDK keys instead of (or in addition to) the fallback above
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxxxxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxx
